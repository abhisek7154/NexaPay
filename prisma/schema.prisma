generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id                  String   @id @default(cuid())
  name                String
  apiKey              String   @unique
  onboardingStatus    String
  kycStatus           String
  perTransactionLimit Float?
  dailyLimit          Float?
  monthlyLimit        Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions        Transaction[]
  paymentMethods      MerchantPaymentMethod[]
}

model PaymentMethod {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  category             String
  isActive             Boolean  @default(true)
  minAmount            Float?
  maxAmount            Float?
  requiresAuth         Boolean  @default(false)
  settlementDays       Int?
  feePercent           Float?
  feeFlat              Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  merchants            MerchantPaymentMethod[]
  transactions         Transaction[]
}

model MerchantPaymentMethod {
  id                  String   @id @default(cuid())
  merchantId          String
  paymentMethodId     String
  isActive             Boolean  @default(true)
  priority             Int?
  feeOverride          Float?
  minOverride          Float?
  maxOverride          Float?
  settlementPriority   Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  merchant             Merchant      @relation(fields: [merchantId], references: [id])
  paymentMethod        PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([merchantId, paymentMethodId])
  @@index([merchantId])
  @@index([paymentMethodId])
}

model Transaction {
  id                       String   @id @default(cuid())
  merchantId               String
  paymentMethodId          String
  customerReference        String?
  amount                   Float
  currency                 String
  status                   String
  idempotencyKey           String
  referenceId              String
  paymentNetworkReference  String?
  authCode                 String?
  failureCode              String?
  feeAmount                Float?
  taxAmount                Float?
  netAmount                Float?
  metadata                 String?
  complianceFlags          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  merchant                 Merchant      @relation(fields: [merchantId], references: [id])
  paymentMethod            PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([merchantId])
  @@index([paymentMethodId])
  @@index([idempotencyKey])
  @@index([referenceId])
  @@index([customerReference])
  @@index([createdAt])
  @@index([status])
}